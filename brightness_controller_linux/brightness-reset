#!/usr/bin/env python3
# -*- coding:utf-8 -*-

import time

try:
    from brightness_controller_linux.util import check_displays, executor
except ImportError:
    import util.check_displays as check_displays
    import util.executor as executor


class BrightnessRestore():
    def __init__(self):
        self.detected_devices = check_displays.detect_display_devices()
        # self.primary_name = self.detected_devices[0]
        for device in self.detected_devices:
            command = (
                "xrandr --output %s --brightness %s --gamma 1.0:1.0:1.0"
                % (device, 1.0)
            )
            executor.execute_command(command)

        # Wait for the asynchronous Wayland worker thread to finish before exiting
        while getattr(executor, "_worker_running", False):
            time.sleep(0.05)


if __name__ == '__main__':
    BrightnessRestore()